# 复制此文件为 .env 并填入自己的密钥（在仓库根目录执行）：
#   cp code/chapter1/.env.example code/chapter1/.env
# .env 已被 .gitignore 忽略，不会提交到 git。

# --- LLM（ClinePass / 任意 OpenAI 兼容服务）---
# ClinePass API Key 获取：https://app.cline.bot -> Settings -> API Keys
CLINE_API_KEY=sk-your-cline-api-key-here
# 可选，默认 https://api.cline.bot/api/v1
CLINE_BASE_URL=https://api.cline.bot/api/v1
# 可选，默认 cline-pass/deepseek-v4.1-flash
CLINE_MODEL_ID=cline-pass/deepseek-v4.1-flash

# --- Tavily 搜索 ---
# Tavily API Key 获取：https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-key-here
