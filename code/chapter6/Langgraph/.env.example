# 复制此文件为 .env 并填入自己的密钥（在仓库根目录执行）：
#   cp code/chapter6/Langgraph/.env.example code/chapter6/Langgraph/.env
# .env 已被 .gitignore 忽略，不会提交到 git。

# --- LLM（ClinePass / 任意 OpenAI 兼容服务）---
# ClinePass API Key 获取：https://app.cline.bot -> Settings -> API Keys
LLM_API_KEY=sk-your-api-key-here
# 可选，默认 https://api.openai.com/v1
LLM_BASE_URL=https://api.cline.bot/api/v1
# 可选，默认 gpt-4o-mini
LLM_MODEL_ID=cline-pass/deepseek-v4.1-flash
# 可选，单次请求超时时间（秒），默认 60
LLM_TIMEOUT=60

# --- Tavily 搜索 ---
# 不配置时程序仍可运行，但会跳过联网搜索、直接基于模型已有知识回答
# Tavily API Key 获取：https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-key-here
